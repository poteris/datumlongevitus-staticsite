// Cloudflare Worker + static assets for datumlongevitus.org.
// Everything in ./public is served as-is. The Worker runs for the home page (to inject the
// Turnstile site key), /api/* and /downloads/*.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "datum-website",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/",
			"/index.html",
			"/api/*",
			"/downloads/*"
		],
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	},
	// Signups: one key per email address. The namespace is `datum-website-signups`; "SIGNUPS" is the
	// name the code uses (env.SIGNUPS), not the resource name, so leave it as is.
	"kv_namespaces": [
		{
			"binding": "SIGNUPS",
			"id": "93c5975bfec049ab99cc1fd65c22b151"
		}
	],
	// Cloudflare Email Service. The sender must be on a domain onboarded for Email Sending.
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": [
				"info@datumlongevitus.org"
			]
		}
	],
	// Per-IP limit on /api/subscribe, a backstop behind Turnstile.
	"ratelimits": [
		{
			"name": "SUBSCRIBE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"vars": {
		"SITE_URL": "https://datumlongevitus.org",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAF5mPm4Wu6gRebx7", // always-pass test version: "1x00000000000000000000AA"
		"FROM_ADDRESS": "info@datumlongevitus.org",
		"FROM_NAME": "Datum Longevitus",
		// Optional: gets a short notice for each confirmed signup. Empty string to disable.
		"NOTIFY_ADDRESS": "info@datumlongevitus.org",
		// Keep "false" until the privacy notice is published.
		"SIGNUP_ENABLED": "false",
		// Bump when the consent wording in public/index.html changes; stored with each signup.
		"CONSENT_VERSION": "2026-11-09",
		"PDF_PATH": "/downloads/dpia-screening-questions.pdf",
		"LINK_TTL_DAYS": "7"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
	   { "pattern": "datumlongevitus.org", "custom_domain": true },
	   { "pattern": "www.datumlongevitus.org", "custom_domain": true }
	]
	// Secrets (not in this file): TOKEN_SECRET and TURNSTILE_SECRET, set with `npx wrangler secret put <NAME>`.
}
