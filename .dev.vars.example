# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
TOKEN_SECRET=change-me-to-a-long-random-string
SIGNUP_ENABLED=true
SITE_URL=http://localhost:8787
# Cloudflare's always-pass Turnstile test secret; pairs with the test site key in index.html.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
